# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，绝不提交（真实密码/邮箱/密钥只写在这里）

# Go 服务监听端口
MT_PORT=8080

# PostgreSQL（原生 Windows 服务 postgresql-x64-16，库 major_travel；postgres 密码只写 .env，绝不提交）
MT_PG_DSN=postgres://postgres:<你的PG密码>@localhost:5432/major_travel?sslmode=disable

# Redis
MT_REDIS_ADDR=localhost:6379

# JWT HS256 签名密钥：足够长的随机串（openssl rand -hex 32）
MT_JWT_SECRET=change-me-to-a-long-random-string

# 注册邀请码（一期小队制；真实取值只写 .env，绝不提交）
MT_INVITE_CODE=change-me

# 邮箱验证码（开发期默认关=注册免验证码；公网开放注册前必须开启）
MT_EMAIL_CODE_ENABLED=false

# SMTP 发信（个人邮箱授权码，开关开启时必填）——465=隐式 TLS，587=STARTTLS
MT_SMTP_HOST=smtp.qq.com
MT_SMTP_PORT=465
MT_SMTP_USER=you@example.com
MT_SMTP_PASS=your-smtp-auth-code
